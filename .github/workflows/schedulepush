name: Scheduled commit

on:
  schedule:
    - cron: "45 9 * * *"  # daily 5:45 PM GMT+8 (09:45 UTC)
  workflow_dispatch:

permissions:
  contents: write

jobs:
  commit-and-push:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # OPTIONAL: run scripts that generate/update files here
      # - run: echo "update" >> log.txt

      - name: Commit & push if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A
          git diff --cached --quiet || git commit -m "Scheduled update"
          git push
